# Install packages if needed
# install.packages(c("sf","dplyr","ggplot2","nngeo","viridis"))

library(sf)
library(dplyr)
library(ggplot2)
library(nngeo)
library(viridis)

# -----------------------------
# 1. Create Sample GIS Data
# -----------------------------

settlements <- data.frame(
  ID = c("S1","S2","S3","S4"),
  Population = c(5000,8000,12000,7000),
  x = c(10,25,40,60),
  y = c(20,30,15,25)
)

facilities <- data.frame(
  Facility = c("H1","H2"),
  x = c(15,50),
  y = c(25,20)
)

settlements_sf <- st_as_sf(
  settlements,
  coords = c("x","y"),
  crs = 3857
)

facilities_sf <- st_as_sf(
  facilities,
  coords = c("x","y"),
  crs = 3857
)

# -----------------------------
# 2. Nearest Facility Analysis
# -----------------------------

nearest <- st_nn(
  settlements_sf,
  facilities_sf,
  k = 1,
  returnDist = TRUE
)

settlements_sf$Nearest_Facility <-
  facilities_sf$Facility[unlist(nearest$nn)]

settlements_sf$Distance_km <-
  round(unlist(nearest$dist),2)

# -----------------------------
# 3. Create Connection Lines
# -----------------------------

nearest_index <- st_nearest_feature(
  settlements_sf,
  facilities_sf
)

lines <- st_connect(
  settlements_sf,
  facilities_sf[nearest_index, ]
)

# -----------------------------
# 4. Create 10 km Service Areas
# -----------------------------

buffers <- st_buffer(
  facilities_sf,
  dist = 10
)

# -----------------------------
# 5. Visualization
# -----------------------------

ggplot() +

  geom_sf(
    data = buffers,
    fill = "lightblue",
    color = "blue",
    alpha = 0.25
  ) +

  geom_sf(
    data = lines,
    color = "grey40",
    linewidth = 0.8
  ) +

  geom_sf(
    data = settlements_sf,
    aes(size = Population,
        color = Distance_km),
    alpha = 0.9
  ) +

  geom_sf(
    data = facilities_sf,
    shape = 17,
    size = 5,
    color = "red"
  ) +

  geom_sf_text(
    data = facilities_sf,
    aes(label = Facility),
    nudge_y = 2
  ) +

  scale_color_viridis(
    option = "plasma",
    name = "Distance (km)"
  ) +

  labs(
    title = "Population Access to Health Facilities",
    subtitle = "Nearest Facility Analysis with Service Areas",
    size = "Population"
  ) +

  theme_minimal()